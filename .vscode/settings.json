{
  // Live Server の設定（開発用フォルダ）
  //
  // ここには index.html / today.html / map.html が並んでいるので、
  // 開きたいファイルを右クリック →「Open with Live Server」で開いてください。

  "liveServer.settings.port": 5501,

  // 路線データ594ファイルを監視対象から外す
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "node_modules/**",
    "data/**",
    "later/**",
    "**/*.geojson",
    "**/*.md"
  ],

  "liveServer.settings.donotShowInfoMsg": true
}
